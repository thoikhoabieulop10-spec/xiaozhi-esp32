{
    "type": "bread-compact-wifi-lcd",
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi-lcd",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7796_320X480_NO_IPS=y",
                "CONFIG_FATFS_LFN_HEAP=y",
                "CONFIG_FATFS_MAX_LFN=255",
                "CONFIG_FATFS_API_ENCODING_UTF_8=y"
            ]
        }
    ]
}
